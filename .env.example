POSTGRES_USER=etax
POSTGRES_PASSWORD=etax_pw
POSTGRES_DB=etax

# Unprivileged Postgres role used only to execute user/LLM-generated SQL
# (app/chat/services/sql_runner.py) — never the table-owning role above.
# Change this for any real deployment.
APP_AGENT_DB_USER=app_agent
APP_AGENT_DB_PASSWORD=app_agent_pw

JWT_SECRET_KEY=change-me-to-a-long-random-string
# The "authenticated" session is sliding, not fixed-duration: it stays alive
# as long as the user keeps being active, and expires this many minutes
# after their LAST request (app/auth/dependencies.py). SESSION_TOKEN_TTL_
# MINUTES is just the outer ceiling on the JWT itself (a token's own expiry
# can't slide), kept well above the inactivity window on purpose.
SESSION_INACTIVITY_TIMEOUT_MINUTES=60
SESSION_TOKEN_TTL_MINUTES=480

ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# ==================================================
# API KEYS — chatbot agent (STT / LLM / TTS)
# ==================================================
COHERE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional extra Gemini keys — add more over time under any label, as long
# as the SAME name is also added to docker-compose.yml's backend
# `environment:` block and to config.py's _GEMINI_KEY_ENV_VARS list (Docker
# only forwards env vars explicitly listed there; a new name in .env alone
# is invisible to the container). All configured keys are pooled together
# and rotated through independently by both the LLM and TTS providers.
GEMINI_API_KEY_1=
mam_GEMINI_API_KEY=
sal_GEMINI_API_KEY=
far_GEMINI_API_KEY=
saf_GEMINI_API_KEY=
ELEVENLABS_TTS_KEY=

# ==================================================
# SPEECH TO TEXT
# ==================================================
# Cohere Transcribe has no auto-detect mode (must be one of a fixed 14
# language codes) — Groq Whisper detects the spoken language first, then
# Cohere transcribes with that language. See backend/app/chat/providers/stt.py.
STT_DETECT_PROVIDER=groq
STT_TRANSCRIBE_PROVIDER=cohere
COHERE_STT_MODEL=cohere-transcribe-03-2026
COHERE_STT_LANGUAGE=ar
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_PROMPT=Tax conversation. Preserve Arabic and English words, taxpayer IDs, numbers, VAT, revenue, expenses, company names and tax terminology.

# ==================================================
# LLM
# ==================================================
LLM_PROVIDER_ORDER=groq,gemini
GROQ_LLM_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b
GEMINI_LLM_MODELS=gemini-flash-latest
SQL_CHAIN_MODEL=openai/gpt-oss-20b

# ==================================================
# PROVIDER MANAGEMENT
# ==================================================
MODEL_COOLDOWN_SECONDS=2

# ==================================================
# TEXT TO SPEECH
# ==================================================
# Gemini first (default/primary), then edge_tts (free, no key needed), then
# ElevenLabs last (kept configurable, not attempted first — see
# backend/app/chat/providers/tts.py for why). Piper (local/offline) was tried
# here but removed after a live, reproducible ONNXRuntime crash on real input.
TTS_PROVIDER_ORDER=gemini,edge_tts,elevenlabs
# Optional override (comma-separated) if TTS should use a different subset
# of keys than the LLM — providers/tts.py rotates to the next key when one
# is rate-limited. Left empty, defaults to the full pool of every GEMINI_*
# key configured above (GEMINI_API_KEY + GEMINI_API_KEY_1/mam_/sal_/far_/
# saf_GEMINI_API_KEY), same pool the LLM uses by default too.
GEMINI_TTS_API_KEYS=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
EDGE_TTS_VOICE_EN=en-US-AriaNeural
EDGE_TTS_VOICE_AR=ar-EG-SalmaNeural
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
