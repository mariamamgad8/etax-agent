POSTGRES_USER=etax
POSTGRES_PASSWORD=etax_pw
POSTGRES_DB=etax

JWT_SECRET_KEY=change-me-to-a-long-random-string

ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# ==================================================
# API KEYS — chatbot agent (STT / LLM / TTS)
# ==================================================
COHERE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_TTS_KEY=

# ==================================================
# SPEECH TO TEXT
# ==================================================
# Cohere Transcribe has no auto-detect mode (must be one of a fixed 14
# language codes) — Groq Whisper detects the spoken language first, then
# Cohere transcribes with that language. See backend/app/chat/providers/stt.py.
STT_DETECT_PROVIDER=groq
STT_TRANSCRIBE_PROVIDER=cohere
COHERE_STT_MODEL=cohere-transcribe-03-2026
COHERE_STT_LANGUAGE=ar
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_PROMPT=Tax conversation. Preserve Arabic and English words, taxpayer IDs, numbers, VAT, revenue, expenses, company names and tax terminology.

# ==================================================
# LLM
# ==================================================
LLM_PROVIDER_ORDER=groq,gemini
GROQ_LLM_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b
GEMINI_LLM_MODELS=gemini-flash-latest
SQL_CHAIN_MODEL=openai/gpt-oss-20b

# ==================================================
# PROVIDER MANAGEMENT
# ==================================================
MODEL_COOLDOWN_SECONDS=60

# ==================================================
# TEXT TO SPEECH
# ==================================================
TTS_PROVIDER_ORDER=elevenlabs,gemini
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ==================================================
# DEMO TAX DATABASE (SQLite, synthetic — separate from the real Postgres auth DB)
# ==================================================
DEMO_DB_PATH=/workspace/data/demo_tax.db
